{
  "name": "ollama-chatbot-vite",
  "private": true,
  "version": "0.0.5",
  "description": "AI-powered construction chatbot using Ollama",
  "author": "Kevin Wong, Joshua Casuga",
  "type": "commonjs",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron.js",
    "electron:dev": "set NODE_ENV=development && vite build && electron electron.js",
    "electron:build": "set NODE_ENV=production && vite build && electron-builder",
    "clean": "rimraf dist dist_electron"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.9.1",
    "marked": "^15.0.7",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.4.54",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.ollama.chatbot",
    "productName": "Ollama Chatbot",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "resources/**/*",
      "backend/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!dist_electron/**"
    ],
    "asarUnpack": [
      "backend/**",
      "resources/**",
      "node_modules/pdf-parse/**",
      "node_modules/mammoth/**",
      "node_modules/tesseract.js/**",
      "node_modules/node-ensure/**"
    ],
    "extraResources": [
      {
        "from": "resources/ollama.exe",
        "to": "ollama.exe"
      },
      {
        "from": "backend/data",
        "to": "backend/data"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "sign": false
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  }
}
